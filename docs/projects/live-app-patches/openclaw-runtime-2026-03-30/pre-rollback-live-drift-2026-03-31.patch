+const EXPLICIT_PAGE_READ_RE =
+  /\b(read (this )?(page|site)|from this page|on this page|visible (page )?(facts?|fields?)|page (title|heading)|hero text|rendered labels?|exact (count|total|version|date)|how many|what (does|is) .* page)\b/i;
+const RECAP_REUSE_RE =
+  /\b(recap|reuse|re-use|already[- ]retrieved|previous result|from earlier|from before)\b/i;
+const COUNT_REQUEST_RE = /\b(how many|count|total|number of)\b/i;
+const HEADING_REQUEST_RE = /\b(heading|title|hero|header)\b/i;
+const VERSION_REQUEST_RE = /\bversion\b/i;
+const DATE_REQUEST_RE = /\bdate\b/i;
+
+function extractPublicHttpUrls(text: string): string[] {
+  const matches = text.match(/\bhttps?:\/\/[^\s<>()]+/gi) ?? [];
+  const urls: string[] = [];
+  for (const raw of matches) {
+    try {
+      const parsed = new URL(raw);
+      const host = parsed.hostname.toLowerCase();
+      if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+        continue;
+      }
+      if (
+        host === "localhost" ||
+        host === "127.0.0.1" ||
+        host === "::1" ||
+        host.endsWith(".local") ||
+        /^10\./.test(host) ||
+        /^192\.168\./.test(host) ||
+        /^172\.(1[6-9]|2\d|3[0-1])\./.test(host)
+      ) {
+        continue;
+      }
+      urls.push(parsed.toString());
+    } catch {
+      continue;
+    }
+  }
+  return [...new Set(urls)];
+}
+
+function shouldForceFreshWebResearch(params: {
+  body: string;
+  currentAgentId: string;
+  cfg: ReturnType<typeof loadConfig>;
+  inputProvenance?: AgentCommandOpts["inputProvenance"];
+}): { urls: string[] } | undefined {
+  if (normalizeAgentId(params.currentAgentId) === "web-researcher") {
+    return undefined;
+  }
+  if (params.inputProvenance?.kind === "inter_session") {
+    return undefined;
+  }
+  if (RECAP_REUSE_RE.test(params.body)) {
+    return undefined;
+  }
+  const urls = extractPublicHttpUrls(params.body);
+  if (urls.length === 0) {
+    return undefined;
+  }
+  if (!EXPLICIT_PAGE_READ_RE.test(params.body)) {
+    return undefined;
+  }
+  const a2aPolicy = createAgentToAgentPolicy(params.cfg);
+  if (!a2aPolicy.isAllowed(normalizeAgentId(params.currentAgentId), "web-researcher")) {
+    return undefined;
+  }
+  return { urls };
+}
+
+function buildFreshWebResearchDelegationPrompt(params: {
+  userBody: string;
+  urls: string[];
+}): string {
+  const targetList = params.urls.map((url) => `- ${url}`).join("\n");
+  return [
+    `objective: Read the exact public page requested by the user and answer the explicit page-read task.`,
+    "",
+    `why_this_matters: This is an explicit external URL/page-read task, so the caller must use fresh current-session retrieval evidence instead of memory, prior delegated output, or prior session context.`,
+    "",
+    "target_urls_if_known:",
+    targetList,
+    "",
+    "required_fields:",
+    "- answer the user's explicit requested page fact(s) from the exact URL",
+    "- if an exact visible field is not confidently recoverable, say that explicitly",
+    "- confidence",
+    "- required_fields_status",
+    "- retrieval_path",
+    "- supporting_evidence",
+    "",
+    "adjacent_context_to_collect:",
+    "- any visible count, total, pagination, or completeness signal relevant to the request",
+    "- whether the page appears truncated or client-rendered",
+    "- any visible evidence that affects reliability",
+    "",
+    "strictness:",
+    "- fact_plus_context",
+    "",
+    "stop_rule:",
+    "- do not stop at a weak first fetch if the requested visible field may still be recoverable from a stronger page-retrieval path",
+    "- never guess",
+    "",
+    "desired_output_shape:",
+    "- direct_answer",
+    "- confidence",
+    "- required_fields_status",
+    "- retrieval_path",
+    "- supporting_evidence",
+    "- adjacent_findings",
+    "- open_questions",
+    "- recommended_next_step",
+    "",
+    "original_user_request:",
+    params.userBody,
+  ].join("\n");
+}
+
+function maybeForceFreshWebResearchDelegation(params: {
+  body: string;
+  currentAgentId: string;
+  requesterSessionKey?: string;
+  requesterChannel?: string;
+  cfg: ReturnType<typeof loadConfig>;
+  inputProvenance?: AgentCommandOpts["inputProvenance"];
+  timeoutMs: number;
+  providerOverride: string;
+  modelOverride: string;
+}): Promise<Awaited<ReturnType<typeof runEmbeddedPiAgent>>> | undefined {
+  const match = shouldForceFreshWebResearch({
+    body: params.body,
+    currentAgentId: params.currentAgentId,
+    cfg: params.cfg,
+    inputProvenance: params.inputProvenance,
+  });
+  if (!match) {
+    return undefined;
+  }
+  return (async () => {
+    const delegatedSessionKey = `agent:web-researcher:page-read:${randomUUID()}`;
+    const delegatedReply = await runAgentStep({
+      sessionKey: delegatedSessionKey,
+      message: buildFreshWebResearchDelegationPrompt({
+        userBody: params.body,
+        urls: match.urls,
+      }),
+      extraSystemPrompt:
+        "Fresh external page-read delegation. Use this fresh session as self-contained retrieval scope. Do not rely on previous session context.",
+      timeoutMs: params.timeoutMs,
+      sourceSessionKey: params.requesterSessionKey,
+      sourceChannel: params.requesterChannel,
+      sourceTool: "fresh_web_delegation_gate",
+    });
+    const text =
+      delegatedReply?.trim() ||
+      "Fresh delegation to web-researcher did not produce a usable result, so I am not answering this explicit external page-read task from memory or prior context.";
+    return {
+      payloads: [{ text }],
+      meta: {
+        durationMs: 0,
+        stopReason: "delegated",
+        agentMeta: {
+          sessionId: params.requesterSessionKey ?? "delegated",
+          provider: params.providerOverride,
+          model: params.modelOverride,
+        },
+      },
+    };
+  })();
+}
+
+type DeterministicFieldKind = "count" | "heading" | "version" | "date";
+
+function shouldUseDeterministicPageRead(params: {
+  currentAgentId: string;
+  sessionKey?: string;
+  body: string;
+}): boolean {
+  if (normalizeAgentId(params.currentAgentId) !== "web-researcher") {
+    return false;
+  }
+  if (!params.sessionKey?.startsWith("agent:web-researcher:page-read:")) {
+    return false;
+  }
+  if (extractPublicHttpUrls(params.body).length === 0) {
+    return false;
+  }
+  return EXPLICIT_PAGE_READ_RE.test(params.body) || COUNT_REQUEST_RE.test(params.body);
+}
+
+function inferDeterministicFieldKinds(text: string): DeterministicFieldKind[] {
+  const kinds = new Set<DeterministicFieldKind>();
+  if (COUNT_REQUEST_RE.test(text)) {
+    kinds.add("count");
+  }
+  if (HEADING_REQUEST_RE.test(text)) {
+    kinds.add("heading");
+  }
+  if (VERSION_REQUEST_RE.test(text)) {
+    kinds.add("version");
+  }
+  if (DATE_REQUEST_RE.test(text)) {
+    kinds.add("date");
+  }
+  if (kinds.size === 0) {
+    kinds.add("count");
+  }
+  return [...kinds];
+}
+
+function stripWrappedExternalContent(text: string): string {
+  return text
+    .replace(/^SECURITY NOTICE:[\s\S]*?<<<EXTERNAL_UNTRUSTED_CONTENT[^>]*>>>\nSource: [^\n]+\n---\n/m, "")
+    .replace(/<<<END_EXTERNAL_UNTRUSTED_CONTENT[^>]*>>>/g, "")
+    .replace(/<<<EXTERNAL_UNTRUSTED_CONTENT[^>]*>>>/g, "")
+    .replace(/^Source: [^\n]+\n---\n/gm, "")
+    .trim();
+}
+
+function uniqueLines(text: string, limit = 12): string[] {
+  const seen = new Set<string>();
+  const lines: string[] = [];
+  for (const raw of text.split("\n")) {
+    const line = raw.replace(/\s+/g, " ").trim();
+    if (!line || seen.has(line)) {
+      continue;
+    }
+    seen.add(line);
+    lines.push(line);
+    if (lines.length >= limit) {
+      break;
+    }
+  }
+  return lines;
+}
+
+function extractEvidenceLine(text: string, pattern: RegExp): string | undefined {
+  return uniqueLines(text, 60).find((line) => pattern.test(line));
+}
+
+function extractExactFieldFromText(params: {
+  text: string;
+  requestedKinds: DeterministicFieldKind[];
+}): {
+  directAnswer?: string;
+  evidenceLines: string[];
+  recoveredKinds: DeterministicFieldKind[];
+} {
+  const cleaned = stripWrappedExternalContent(params.text);
+  const evidenceLines: string[] = [];
+  const recoveredKinds = new Set<DeterministicFieldKind>();
+  let directAnswer: string | undefined;
+
+  if (params.requestedKinds.includes("count")) {
+    const countPatterns = [
+      /\bSkills\s*\(([\d,]+)\)/i,
+      /\b([A-Z][A-Za-z0-9 .:_/-]{1,80})\s*\(([\d,]+)\)/,
+      /\b([\d,]+)\s+(skills|results|items|entries)\b/i,
+    ];
+    for (const pattern of countPatterns) {
+      const match = cleaned.match(pattern);
+      if (!match) {
+        continue;
+      }
+      const count = match[1] && /\d/.test(match[1]) ? match[1] : match[2];
+      const label = match[2] && /\d/.test(match[2]) ? match[1] : match[2];
+      const evidenceLine = extractEvidenceLine(cleaned, pattern);
+      if (evidenceLine) {
+        evidenceLines.push(evidenceLine);
+      }
+      recoveredKinds.add("count");
+      if (label && /^skills$/i.test(label)) {
+        directAnswer = `ClawHub.AI shows ${count} skills on that page.`;
+      } else if (label) {
+        directAnswer = `${label} shows ${count}.`;
+      } else {
+        directAnswer = `The page shows ${count}.`;
+      }
+      break;
+    }
+  }
+
+  if (!directAnswer && params.requestedKinds.includes("heading")) {
+    const headingLine = uniqueLines(cleaned, 20).find((line) =>
+      /^[A-Z][A-Za-z0-9 .:_/()-]{2,120}$/.test(line),
+    );
+    if (headingLine) {
+      evidenceLines.push(headingLine);
+      recoveredKinds.add("heading");
+      directAnswer = `The visible page heading is "${headingLine}".`;
+    }
+  }
+
+  if (!directAnswer && params.requestedKinds.includes("version")) {
+    const versionMatch = cleaned.match(/\bv?\d+\.\d+(?:\.\d+)?(?:-[A-Za-z0-9.-]+)?\b/);
+    if (versionMatch) {
+      const evidenceLine = extractEvidenceLine(cleaned, new RegExp(versionMatch[0].replace(/[.*+?^${}()|[\]\\]/g, "\\$&")));
+      if (evidenceLine) {
+        evidenceLines.push(evidenceLine);
+      }
+      recoveredKinds.add("version");
+      directAnswer = `The visible version on the page is ${versionMatch[0]}.`;
+    }
+  }
+
+  if (!directAnswer && params.requestedKinds.includes("date")) {
+    const dateMatch =
+      cleaned.match(/\b\d{4}-\d{2}-\d{2}\b/) ??
+      cleaned.match(
+        /\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]* \d{1,2}, \d{4}\b/i,
+      );
+    if (dateMatch) {
+      const evidenceLine = extractEvidenceLine(cleaned, new RegExp(dateMatch[0].replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i"));
+      if (evidenceLine) {
+        evidenceLines.push(evidenceLine);
+      }
+      recoveredKinds.add("date");
+      directAnswer = `The visible date on the page is ${dateMatch[0]}.`;
+    }
+  }
+
+  return {
+    directAnswer,
+    evidenceLines: [...new Set(evidenceLines)],
+    recoveredKinds: [...recoveredKinds],
+  };
+}
+
+async function runDeterministicExactPageRead(params: {
+  body: string;
+  cfg: ReturnType<typeof loadConfig>;
+}): Promise<string> {
+  const url = extractPublicHttpUrls(params.body)[0];
+  if (!url) {
+    return JSON.stringify(
+      {
+        direct_answer: "I could not identify a public HTTP(S) URL in the page-read request.",
+        confidence: "low",
+        required_fields_status: "missing_url",
+        retrieval_path: ["no explicit external URL found in delegated request"],
+        supporting_evidence: [],
+        adjacent_findings: [],
+        open_questions: ["Which exact public page URL should be read?"],
+        recommended_next_step: "Provide the exact external page URL.",
+      },
+      null,
+      2,
+    );
+  }
+
+  const requestedKinds = inferDeterministicFieldKinds(params.body);
+  const retrievalPath: string[] = [`web_fetch exact URL: ${url}`];
+  const supportingEvidence: string[] = [];
+  const adjacentFindings: string[] = [];
+
+  const webFetchTool = createWebFetchTool({ config: params.cfg });
+  if (!webFetchTool?.execute) {
+    retrievalPath.push("web_fetch unavailable");
+  } else {
+    try {
+      const fetchResult = await webFetchTool.execute("deterministic_page_read_fetch", {
+        url,
+        extractMode: "text",
+        maxChars: 20000,
+      });
+      const fetchDetails =
+        fetchResult.details && typeof fetchResult.details === "object"
+          ? (fetchResult.details as Record<string, unknown>)
+          : undefined;
+      const fetchText = typeof fetchDetails?.text === "string" ? fetchDetails.text : "";
+      const fetchMatch = extractExactFieldFromText({ text: fetchText, requestedKinds });
+      supportingEvidence.push(...fetchMatch.evidenceLines);
+      if (typeof fetchDetails?.title === "string" && fetchDetails.title.trim()) {
+        adjacentFindings.push(`fetch title: ${stripWrappedExternalContent(fetchDetails.title)}`);
+      }
+      if (fetchMatch.directAnswer) {
+        return JSON.stringify(
+          {
+            direct_answer: fetchMatch.directAnswer,
+            confidence: "high",
+            required_fields_status: "recovered_from_fetch",
+            retrieval_path: retrievalPath,
+            supporting_evidence: [...new Set(supportingEvidence)],
+            adjacent_findings: [...new Set(adjacentFindings)],
+            open_questions: [],
+            recommended_next_step: "No stronger retrieval path needed because the requested visible field was recovered from the exact URL fetch output.",
+          },
+          null,
+          2,
+        );
+      }
+      retrievalPath.push("fetch did not clearly recover the requested visible field");
+    } catch (err) {
+      retrievalPath.push(`web_fetch failed: ${String(err)}`);
+    }
+  }
+
+  let browserAttempted = false;
+  let browserRecovered = false;
+  let browserAttemptError: string | undefined;
+
+  for (let attempt = 1; attempt <= 2; attempt++) {
+    try {
+      browserAttempted = true;
+      if (attempt === 1) {
+        retrievalPath.push("browser exact-URL escalation");
+      } else {
+        retrievalPath.push("browser narrow retry");
+      }
+      const status = await browserStatus();
+      if (!status.running) {
+        await browserStart();
+        retrievalPath.push("browser auto-started");
+      }
+      const tab = await browserOpenTab(undefined, url);
+      if (attempt > 1) {
+        await browserNavigate(undefined, { url, targetId: tab.targetId });
+      }
+      const snapshot = await browserSnapshot(undefined, {
+        format: "ai",
+        targetId: tab.targetId,
+        maxChars: 12000,
+      });
+      if (snapshot.format !== "ai") {
+        retrievalPath.push("browser snapshot returned non-ai format");
+        continue;
+      }
+      const snapshotText = snapshot.snapshot ?? "";
+      const snapshotMatch = extractExactFieldFromText({
+        text: snapshotText,
+        requestedKinds,
+      });
+      supportingEvidence.push(...snapshotMatch.evidenceLines);
+      adjacentFindings.push(
+        ...uniqueLines(snapshotText, 8).slice(0, 3).map((line) => `browser visible: ${line}`),
+      );
+      if (snapshotMatch.directAnswer) {
+        browserRecovered = true;
+        return JSON.stringify(
+          {
+            direct_answer: snapshotMatch.directAnswer,
+            confidence: "high",
+            required_fields_status: "recovered_from_browser_visible_field",
+            retrieval_path: retrievalPath,
+            supporting_evidence: [...new Set(supportingEvidence)],
+            adjacent_findings: [...new Set(adjacentFindings)],
+            open_questions: [],
+            recommended_next_step:
+              "No stronger path needed because the exact visible field was recovered from the rendered page.",
+          },
+          null,
+          2,
+        );
+      }
+      browserAttemptError = "browser snapshot still did not clearly expose the requested visible field";
+    } catch (err) {
+      browserAttemptError = String(err);
+      retrievalPath.push(`browser attempt ${String(attempt)} failed: ${browserAttemptError}`);
+    }
+  }
+
+  return JSON.stringify(
+    {
+      direct_answer:
+        "I did not confidently recover the exact requested visible field from the live page.",
+      confidence: browserAttempted && !browserRecovered ? "low" : "low",
+      required_fields_status: "not_confidently_recovered",
+      retrieval_path: retrievalPath,
+      supporting_evidence: [...new Set(supportingEvidence)],
+      adjacent_findings: [...new Set(adjacentFindings)],
+      open_questions: browserAttemptError ? [browserAttemptError] : [],
+      recommended_next_step:
+        "Use the retrieval_path to inspect the stronger exact-URL attempts that were made before giving up; do not guess the value.",
+    },
+    null,
+    2,
+  );
+}
+
+function maybeRunDeterministicWebResearchPageRead(params: {
+  body: string;
+  currentAgentId: string;
+  sessionKey?: string;
+  cfg: ReturnType<typeof loadConfig>;
+  providerOverride: string;
+  modelOverride: string;
+}): Promise<Awaited<ReturnType<typeof runEmbeddedPiAgent>>> | undefined {
+  if (
+    !shouldUseDeterministicPageRead({
+      currentAgentId: params.currentAgentId,
+      sessionKey: params.sessionKey,
+      body: params.body,
+    })
+  ) {
+    return undefined;
+  }
+  return (async () => {
+    const text = await runDeterministicExactPageRead({
+      body: params.body,
+      cfg: params.cfg,
+    });
+    return {
+      payloads: [{ text }],
+      meta: {
+        durationMs: 0,
+        stopReason: "deterministic_page_read",
+        agentMeta: {
+          sessionId: params.sessionKey ?? "deterministic_page_read",
+          provider: params.providerOverride,
+          model: params.modelOverride,
+        },
+      },
+    };
+  })();
+}
