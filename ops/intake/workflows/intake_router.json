    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const source = (item.json.source || '').trim();\n  const project = (item.json.project || '').trim();\n\n  let route_family = 'unmatched';\n\n  if (source === 'manual') {\n    route_family = 'manual';\n  } else if (source === 'openclaw' && project === 'ops') {\n    route_family = 'openclaw_ops';\n  } else if (source === 'openclaw' && project === 'workflow') {\n    route_family = 'openclaw_workflow';\n  } else if (source === 'openclaw' && project === 'task') {\n    route_family = 'openclaw_task';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      route_family,\n    },\n  };\n});"
      },
