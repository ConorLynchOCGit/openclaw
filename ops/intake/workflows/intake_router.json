      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE intake_events SET routing_status = 'processing', routing_attempts = routing_attempts + 1 WHERE id = $1 AND routing_status = 'pending' RETURNING id, source, project, event_type, route_key, payload, routing_attempts",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{$json.id}}"
