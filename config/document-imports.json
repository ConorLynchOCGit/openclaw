{
  "version": 1,
  "imports": [
    {
      "id": "repo-docs",
      "sourceEnv": "OPENCLAW_IMPORTED_REPO_DOCS_DIR",
      "sourceType": "directory",
      "workspacePath": "imports/system_docs/repo-docs",
      "mode": "bind-ro",
      "readOnly": true
    },
    {
      "id": "repo-agents",
      "sourceEnv": "OPENCLAW_IMPORTED_REPO_AGENTS_FILE",
      "sourceType": "file",
      "workspacePath": "imports/system_docs/repo-root/AGENTS.md",
      "mode": "bind-ro",
      "readOnly": true
    },
    {
      "id": "repo-readme",
      "sourceEnv": "OPENCLAW_IMPORTED_REPO_README_FILE",
      "sourceType": "file",
      "workspacePath": "imports/system_docs/repo-root/README.md",
      "mode": "bind-ro",
      "readOnly": true
    },
    {
      "id": "probe-docs",
      "sourceEnv": "OPENCLAW_IMPORTED_DOC_PROBE_DIR",
      "sourceType": "directory",
      "workspacePath": "imports/system_docs/_probes",
      "mode": "bind-ro",
      "readOnly": true
    }
  ]
}
