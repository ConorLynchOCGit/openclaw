{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "OPENCLAW_TEST_INCLUDE_SLOW_CONFIGS",
    "OPENCLAW_TEST_MAX_OLD_SPACE_SIZE_MB",
    "OPENCLAW_TEST_PROJECTS_SKIP_CONFIGS",
    "OPENCLAW_TEST_WORKERS",
    "OPENCLAW_VITEST_MAX_OLD_SPACE_SIZE_MB",
    "OPENCLAW_VITEST_MAX_WORKERS",
    "OPENCLAW_VITEST_NO_OUTPUT_TIMEOUT_MS"
  ],
  "globalDependencies": ["package.json", "pnpm-lock.yaml", "turbo.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "assets/viewer-runtime.js", "../dist/control-ui/**"]
    },
    "build:root:all": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:write-cli-compat"]
    },
    "build:root:build-stamp": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:write-npm-update-compat-sidecars"]
    },
    "build:root:canvas-a2ui-bundle": {
      "cache": false,
      "outputs": []
    },
    "build:root:canvas-a2ui-copy": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:check-plugin-sdk-exports"]
    },
    "build:root:check-plugin-sdk-exports": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:write-plugin-sdk-entry-dts"]
    },
    "build:root:copy-export-html-templates": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:copy-hook-metadata"]
    },
    "build:root:copy-hook-metadata": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:canvas-a2ui-copy"]
    },
    "build:root:postbuild": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:plugin-sdk-dts", "build:root:tsdown"]
    },
    "build:root:plugin-sdk-dts": {
      "cache": true,
      "outputs": ["dist/plugin-sdk/**", ".artifacts/build-cache/plugin-sdk-dts.json"]
    },
    "build:root:runtime-postbuild": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:tsdown"]
    },
    "build:root:tsdown": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:canvas-a2ui-bundle"]
    },
    "build:root:write-build-info": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:copy-export-html-templates"]
    },
    "build:root:write-cli-compat": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:write-cli-startup-metadata"]
    },
    "build:root:write-cli-startup-metadata": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:write-build-info"]
    },
    "build:root:write-npm-update-compat-sidecars": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:runtime-postbuild"]
    },
    "build:root:write-plugin-sdk-entry-dts": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["build:root:plugin-sdk-dts"]
    },
    "check": {
      "cache": true,
      "outputs": []
    },
    "check:no-conflict-markers": {
      "cache": true,
      "outputs": []
    },
    "check:topology": {
      "cache": true,
      "outputs": []
    },
    "check:base-config-schema": {
      "cache": true,
      "outputs": []
    },
    "check:bundled-channel-config-metadata": {
      "cache": true,
      "outputs": []
    },
    "tool-display:check": {
      "cache": true,
      "outputs": []
    },
    "check:host-env-policy:swift": {
      "cache": true,
      "outputs": []
    },
    "check:import-cycles": {
      "cache": true,
      "outputs": []
    },
    "check:madge-import-cycles": {
      "cache": true,
      "outputs": []
    },
    "tsgo": {
      "cache": true,
      "dependsOn": ["check:root:prepare-extension-package-boundary-artifacts"],
      "outputs": []
    },
    "check:root:prepare-extension-package-boundary-artifacts": {
      "cache": true,
      "outputs": [
        "dist/plugin-sdk/.boundary-entry-shims.stamp",
        "dist/plugin-sdk/.tsbuildinfo",
        "dist/plugin-sdk/src/plugin-sdk/*.d.ts",
        "packages/plugin-sdk/dist/.tsbuildinfo",
        "packages/plugin-sdk/dist/src/plugin-sdk/*.d.ts"
      ]
    },
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:webhook:no-low-level-body-read": {
      "cache": true,
      "outputs": []
    },
    "lint:auth:no-pairing-store-group": {
      "cache": true,
      "outputs": []
    },
    "lint:auth:pairing-account-scope": {
      "cache": true,
      "outputs": []
    },
    "check:root:all": {
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "check:no-conflict-markers",
        "check:topology",
        "check:base-config-schema",
        "check:bundled-channel-config-metadata",
        "tool-display:check",
        "check:host-env-policy:swift",
        "check:import-cycles",
        "check:madge-import-cycles",
        "tsgo",
        "check:root:prepare-extension-package-boundary-artifacts",
        "lint",
        "lint:webhook:no-low-level-body-read",
        "lint:auth:no-pairing-store-group",
        "lint:auth:pairing-account-scope"
      ]
    },
    "test": {
      "cache": true,
      "outputs": []
    },
    "test:root:agentic": {
      "cache": true,
      "outputs": []
    },
    "test:root:auto-reply": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-bundled": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-contracts": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-runtime": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-support-boundary": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-fast": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-security": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-src": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-support": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-support-slow": {
      "cache": true,
      "outputs": []
    },
    "test:root:core-unit-ui": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:acpx": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:all": {
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "test:root:extensions:acpx",
        "test:root:extensions:bluebubbles",
        "test:root:extensions:channels",
        "test:root:extensions:diffs",
        "test:root:extensions:feishu",
        "test:root:extensions:irc",
        "test:root:extensions:mattermost",
        "test:root:extensions:matrix",
        "test:root:extensions:memory",
        "test:root:extensions:messaging",
        "test:root:extensions:msteams",
        "test:root:extensions:providers",
        "test:root:extensions:telegram",
        "test:root:extensions:voice-call",
        "test:root:extensions:whatsapp",
        "test:root:extensions:zalo",
        "test:root:extensions:browser",
        "test:root:extensions:qa",
        "test:root:extensions:media",
        "test:root:extensions:misc"
      ]
    },
    "test:root:extensions:bluebubbles": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:browser": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:channels": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:diffs": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:feishu": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:irc": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:mattermost": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:matrix": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:media": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:memory": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:messaging": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:misc": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:msteams": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:providers": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:qa": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:telegram": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:voice-call": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:whatsapp": {
      "cache": true,
      "outputs": []
    },
    "test:root:extensions:zalo": {
      "cache": true,
      "outputs": []
    },
    "test:root:all": {
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "test:root:core-unit-fast",
        "test:root:core-unit-src",
        "test:root:core-unit-security",
        "test:root:core-unit-ui",
        "test:root:core-unit-support",
        "test:root:core-unit-support-slow",
        "test:root:core-support-boundary",
        "test:root:core-contracts",
        "test:root:core-bundled",
        "test:root:core-runtime",
        "test:root:agentic",
        "test:root:auto-reply",
        "test:root:extensions:all"
      ]
    }
  }
}
