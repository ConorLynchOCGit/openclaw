{
  "name": "@openclaw/diffs",
  "version": "2026.3.30",
  "private": true,
  "description": "OpenClaw diff viewer plugin",
  "type": "module",
  "scripts": {
    "build": "pnpm build:viewer",
    "build:viewer": "pnpm exec esbuild src/viewer-client.ts --platform=browser --format=esm --minify --outfile=assets/viewer-runtime.js",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.extensions.config.ts extensions/diffs/src"
  },
  "dependencies": {
    "@pierre/diffs": "1.1.7",
    "@pierre/theme": "0.0.24",
    "@sinclair/typebox": "0.34.49",
    "playwright-core": "1.58.2"
  },
  "openclaw": {
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "extensions": [
      "./index.ts"
    ]
  }
}
