{
  "id": "x-intelligence",
  "activation": {
    "onStartup": true
  },
  "name": "X Intelligence",
  "description": "Read-only official X source operations with bounded, compliance-aware evidence.",
  "setup": {
    "providers": [
      {
        "id": "x-intelligence",
        "envVars": [
          "X_BEARER_TOKEN",
          "X_OWNED_METRICS_TOKEN"
        ]
      }
    ]
  },
  "uiHints": {
    "apiKey": {
      "label": "X Read-only Bearer Token",
      "help": "Server-side application bearer token for public read-only X operations.",
      "sensitive": true
    },
    "ownedMetricsApiKey": {
      "label": "X Owned-metrics Credential",
      "help": "Separate SecretRef or X_OWNED_METRICS_TOKEN user-context credential for explicitly approved owned-account metrics. Never falls back to X_BEARER_TOKEN.",
      "sensitive": true
    },
    "timeoutSeconds": {
      "label": "X Request Timeout",
      "help": "Per-request timeout for bounded read-only X operations."
    },
    "cacheTtlMinutes": {
      "label": "X Content Cache TTL",
      "help": "Mutable content cache lifetime, capped at 24 hours."
    },
    "episodeBudgets": {
      "label": "X Episode Request Budgets",
      "help": "Optional per-purpose read-request caps for one X Researcher session."
    },
    "complianceRefresh": {
      "label": "X Content Compliance Refresh",
      "help": "Bounded native refresh of active cached post/profile IDs. Disabled until developer-use and retention acceptance passes."
    }
  },
  "contracts": {
    "tools": [
      "x_posts",
      "x_counts",
      "x_users",
      "x_timelines",
      "x_trends",
      "x_metrics"
    ]
  },
  "toolMetadata": {
    "x_posts": {
      "optional": true
    },
    "x_counts": {
      "optional": true
    },
    "x_users": {
      "optional": true
    },
    "x_timelines": {
      "optional": true
    },
    "x_trends": {
      "optional": true
    },
    "x_metrics": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "apiKey": {
        "type": [
          "string",
          "object"
        ]
      },
      "ownedMetricsApiKey": {
        "type": [
          "string",
          "object"
        ]
      },
      "timeoutSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120
      },
      "cacheTtlMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1440
      },
      "episodeBudgets": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_research": { "type": "integer", "minimum": 1, "maximum": 100 },
          "topic_pulse": { "type": "integer", "minimum": 1, "maximum": 100 },
          "influence_map": { "type": "integer", "minimum": 1, "maximum": 100 },
          "format_study": { "type": "integer", "minimum": 1, "maximum": 100 },
          "source_verification": { "type": "integer", "minimum": 1, "maximum": 100 },
          "owned_performance": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "complianceRefresh": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "intervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "maxIdsPerPass": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    }
  }
}
